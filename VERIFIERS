# pi-config VERIFIERS — deterministic checks run by agent-loop (see ~/.pi/agent-loop-v1/loop.sh)
# One command per line; run from the repo root. Lines starting with # are comments.
# The loop always runs `git diff --check` in addition to these.

# 1. All managed JSON files must parse
jq empty agent/settings.json
jq empty agent/models.json
jq empty agent/models-store.json
jq empty agent/ollama-cloud.json
jq empty agent/cursor-sdk.json
jq empty agent/cursor-sdk-context-windows.json
jq empty agent/intercom/config.json
jq empty providers/kimi-coding/config.json

# 2. settings.json shape: enabledModels is a non-empty array of "provider/id" strings
jq -e '(.enabledModels | type == "array" and length > 0) and (all(.enabledModels[]; type == "string" and contains("/")))' agent/settings.json

# 3. models-store.json: model ids are unique within each provider
jq -e 'to_entries | all(.[].value.models; ([.[].id] | unique | length) == (length))' agent/models-store.json

# 4. No trailing whitespace in managed markdown
! grep -rn '[[:blank:]]$' README.md agent/prompts/ 2>/dev/null

# 5. LOOP.md <-> loop.sh env-default sync (task-104)
agent-loop-v1/tests/test_loop_md_sync.sh
