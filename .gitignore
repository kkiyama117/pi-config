# Mutable pi runtime state. Never commit credentials, sessions, package clones,
# logs, or caches to this config repository.
auth.json
trust.json
sessions/
transcripts/
logs/
cache/
npm/
git/
*.log

# Cache of `pi-acp`
pi-acp/session-map.json

# Generated cache — never managed (cursor-sdk-catalog-refresh.sop.md)
cursor-sdk-model-list.json
cursor-sdk-model-list.*.json

# Direct-clone runtime state (pi-config is cloned into ~/.pi; these live alongside managed files)
run-history.jsonl
agent/missions/*
agent/intercom/broker.*
agent/intercom/broker-launch.vbs
agent/intercom/broker.port.json
agent/intercom/broker.spawn.lock
agent/intercom/extension-state/
.pi-subagents/
*.pre-pi-config.*
agent/extensions/herdr-agent-state.ts

